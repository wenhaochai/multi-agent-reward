From 3346ebde5995d4715614ed1916d848c0ea18687f Mon Sep 17 00:00:00 2001
From: Wenhao Chai <reselfchai@gmail.com>
Date: Sat, 3 Oct 2026 14:54:16 -0400
Subject: [PATCH 6/7] --replay-rollout-data/--replay-rollout-until: replay
 another run's rollout dump for the first N rollouts

Value pretraining shared across runs with the same frozen actor: rollouts below N load the dump instead of
generating (SGLang still starts for later rollouts and evals); the data source still advances so prompt order
and sample indices match a live run.
---
 miles/ray/rollout/debug_data.py       |  9 +++++++++
 miles/ray/rollout/rollout_executor.py | 11 ++++++++++-
 miles/utils/arguments.py              | 13 +++++++++++++
 3 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/miles/ray/rollout/debug_data.py b/miles/ray/rollout/debug_data.py
index 9c726f114..93f81e954 100644
--- a/miles/ray/rollout/debug_data.py
+++ b/miles/ray/rollout/debug_data.py
@@ -114,6 +114,15 @@ def load_debug_rollout_data(args, rollout_id: int) -> tuple[list[Sample], dict]:
     return data, metadata
 
 
+def load_replay_rollout_data(args, rollout_id: int) -> tuple[list[Sample], dict]:
+    """--replay-rollout-data: one rollout of another run's --save-debug-rollout-data dump (value pretraining shared
+    across runs with the same frozen actor)."""
+    path = Path(args.replay_rollout_data.format(rollout_id=rollout_id))
+    data, metadata = _load_rollout_data_file(path)
+    logger.info(f"Replay rollout {rollout_id}: {len(data)} samples from {path}")
+    return data, metadata
+
+
 def save_debug_rollout_data(
     args, data, rollout_id, evaluation: bool, metadata: dict | None = None, trainer_model_id: str | None = None
 ) -> None:
diff --git a/miles/ray/rollout/rollout_executor.py b/miles/ray/rollout/rollout_executor.py
